@model AdminLoginModel

@{
    Layout = "_AdminLoginLayout";
    NopHtml.AddTitleParts(T("Admin.Login.Title").Text);
}

<div class="text-center mb-3">
    <p class="login-box-msg">@T("Admin.Login.Title")</p>
</div>

@if (Model.IsGoogleEnabled)
{
    <div class="row">
        <div class="col-12">
            <a asp-area="Admin"
               asp-controller="AdminLogin"
               asp-action="Google"
               asp-route-returnUrl="@Model.ReturnUrl"
               class="btn btn-outline-secondary btn-block">
                <i class="fab fa-google mr-2"></i>
                @T("Admin.Login.GoogleButton")
            </a>
        </div>
    </div>
}
else
{
    <div class="alert alert-warning mb-0">
        @T("Admin.Login.GoogleDisabled")
    </div>
}
