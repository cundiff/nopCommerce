@model ConfigurationModel

@{
    Layout = "_ConfigurePlugin";
}

<form asp-controller="HeadlessApi" asp-action="Configure" method="post">
    <div class="cards-group">
        <div class="card card-default">
            <div class="card-body">
                <p>
                    This plugin exposes a free, open-source headless storefront API that can be used as the
                    backend for a <strong>Vercel Commerce</strong> / Next.js storefront.
                </p>
                <p>
                    The API is served under: <code>@Model.ApiBaseUrl</code>
                </p>
                <p>
                    Configure your storefront with these environment variables:
                </p>
                <ul>
                    <li><code>NOPCOMMERCE_API_URL</code> = <code>@Model.ApiBaseUrl</code></li>
                    <li><code>NOPCOMMERCE_REVALIDATION_SECRET</code> = your revalidation secret (below)</li>
                </ul>

                <div class="form-group row">
                    <div class="col-md-3">
                        <nop-label asp-for="AllowedOrigins" />
                    </div>
                    <div class="col-md-9">
                        <nop-editor asp-for="AllowedOrigins" />
                        <span asp-validation-for="AllowedOrigins"></span>
                        <span class="form-text text-muted">
                            Comma-separated list of allowed storefront origins (CORS), e.g.
                            <code>https://my-store.vercel.app,http://localhost:3000</code>. Use <code>*</code> to allow any origin.
                        </span>
                    </div>
                </div>

                <div class="form-group row">
                    <div class="col-md-3">
                        <nop-label asp-for="TokenExpirationDays" />
                    </div>
                    <div class="col-md-9">
                        <nop-editor asp-for="TokenExpirationDays" />
                        <span asp-validation-for="TokenExpirationDays"></span>
                    </div>
                </div>

                <div class="form-group row">
                    <div class="col-md-3">
                        <nop-label asp-for="SecretKey" />
                    </div>
                    <div class="col-md-9">
                        <nop-editor asp-for="SecretKey" />
                        <span asp-validation-for="SecretKey"></span>
                        <span class="form-text text-muted">
                            Secret used to sign cart/customer tokens. Keep this private. Clearing it regenerates a new key
                            (this invalidates existing carts).
                        </span>
                    </div>
                </div>

                <div class="form-group row">
                    <div class="col-md-3">
                        <nop-label asp-for="EnableWebhooks" />
                    </div>
                    <div class="col-md-9">
                        <nop-editor asp-for="EnableWebhooks" />
                        <span asp-validation-for="EnableWebhooks"></span>
                    </div>
                </div>

                <div class="form-group row">
                    <div class="col-md-3">
                        <nop-label asp-for="RevalidationWebhookUrl" />
                    </div>
                    <div class="col-md-9">
                        <nop-editor asp-for="RevalidationWebhookUrl" />
                        <span asp-validation-for="RevalidationWebhookUrl"></span>
                        <span class="form-text text-muted">
                            e.g. <code>https://my-store.vercel.app/api/revalidate</code>
                        </span>
                    </div>
                </div>

                <div class="form-group row">
                    <div class="col-md-3">
                        <nop-label asp-for="RevalidationSecret" />
                    </div>
                    <div class="col-md-9">
                        <nop-editor asp-for="RevalidationSecret" />
                        <span asp-validation-for="RevalidationSecret"></span>
                    </div>
                </div>

                <div class="form-group row">
                    <div class="col-md-9 offset-md-3">
                        <button type="submit" name="save" class="btn btn-primary">@T("Admin.Common.Save")</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</form>
